DEBUG=True
SECRET_KEY=change-me
APP_ENV=development

# Produção: use APP_ENV=production e DEBUG=False. Nesse ambiente, os hosts
# permitidos devem ser somente botuka.com.br,www.botuka.com.br.

PLATFORM_URL=http://127.0.0.1:7700
SERVICES_URL=http://127.0.0.1:7701
VENDAS_URL=http://127.0.0.1:7710
VENDAS_BASE_URL=http://127.0.0.1:7710
PLATFORM_LOGIN_URL=http://127.0.0.1:7700/conta/login/
PUBLIC_BASE_URL=http://127.0.0.1:7700
CORE_PUBLIC_URL=http://127.0.0.1:7700

DB_ENGINE=django.db.backends.postgresql
DB_NAME=botuka1
DB_USER=botuka_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:7700,http://localhost:7700,https://botuka.com.br,https://www.botuka.com.br
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_NAME=botuka_sessionid
# Em produção, use .botuka.com.br para compartilhar a sessão entre subdomínios.
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax
USE_X_FORWARDED_HOST=False
USE_PROXY_SSL_HEADER=False

CNPJ_PROVIDER=mock
CNPJ_API_BASE_URL=
CNPJ_API_TOKEN=
CNPJ_API_TIMEOUT=10
CNPJ_API_CACHE_HOURS=24

# SEO e mensuração (IDs vazios não carregam scripts externos)
SITE_NAME=BOTUKA
SITE_URL=http://127.0.0.1:7700
SITE_DEFAULT_DESCRIPTION=Empresas, serviços, eventos, vagas e notícias de Botucatu em um só lugar.
SITE_DEFAULT_IMAGE=/static/img/seo/botuka-default-1200x630.png
SITE_DEFAULT_LOCALE=pt_BR
GOOGLE_TAG_MANAGER_ID=
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
META_PIXEL_ID=
META_DOMAIN_VERIFICATION=
MICROSOFT_CLARITY_ID=
BING_SITE_VERIFICATION=
PINTEREST_DOMAIN_VERIFICATION=
TWITTER_SITE=
TWITTER_CREATOR=
ENABLE_ANALYTICS=False
ENABLE_MARKETING_TAGS=False

DEBUG=True
SECRET_KEY=change-me
APP_ENV=development

# Produção: use APP_ENV=production e DEBUG=False. Nesse ambiente, os hosts
# permitidos devem ser somente botuka.com.br,www.botuka.com.br.

PLATFORM_URL=http://127.0.0.1:7700
SERVICES_URL=http://127.0.0.1:7701
PUBLIC_BASE_URL=http://127.0.0.1:7700
CORE_PUBLIC_URL=http://127.0.0.1:7700

DB_ENGINE=django.db.backends.postgresql
DB_NAME=botuka1
DB_USER=botuka_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:7700,http://localhost:7700,https://botuka.com.br,https://www.botuka.com.br
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax
USE_X_FORWARDED_HOST=False
USE_PROXY_SSL_HEADER=False

CNPJ_PROVIDER=mock
CNPJ_API_BASE_URL=
CNPJ_API_TOKEN=
CNPJ_API_TIMEOUT=10
CNPJ_API_CACHE_HOURS=24
